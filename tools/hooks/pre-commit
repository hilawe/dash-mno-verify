#!/usr/bin/env bash
# Blocks a commit touching gated paths unless the test suite passes.
#
# WHY A HOOK AND NOT A HABIT. This repository's write-time discipline (docs/PRECOMMIT_ADOPTION.md)
# requires that a mandatory gate blocks, with its exit code as the decision. A check someone runs by
# hand can fail, print its failure, and still be followed by a commit. The sibling project that
# supplied this pattern watched exactly that happen, so the gate lives here, inside git.
#
# WHAT IS GATED. The suite runs when the staged set touches code the tests cover or the tooling the
# tests depend on. Documentation-only commits (docs/, README, review findings) skip the suite, since
# rule 3 of the discipline covers prose claims and a 2.5 minute suite adds nothing to them.
#
# KNOWN LIMIT, DELIBERATE. The suite runs against the working tree, not the staged index. A
# partially staged tree can pass while the commit content would fail. Closing that needs a stash
# dance that has its own failure modes, so the simple form is kept and the limit is stated.
#
# Override with `git commit --no-verify` when a failing suite is genuinely intended (committing a
# reproduction of an open defect is the obvious case), and say why in the commit message.
set -u
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# Added, Copied, Modified, Renamed. Deletions of gated files still gate, via --diff-filter=D below,
# because deleting a module or a test changes what the suite proves. A failed read is a refusal,
# never a skip, because an empty answer and no answer must not look alike (fail closed).
if ! staged="$(git diff --cached --name-only --diff-filter=ACMRD)"; then
  echo "COMMIT BLOCKED: could not read the staged file list (git diff --cached failed)."
  exit 1
fi
[ -z "$staged" ] && exit 0

# EVERY GATED PATH IS A DELIBERATE ONE. core, circuits, contract, prover are the note's minimum.
# adapters and oracle are added because that is where this repository's defect history actually
# clusters (review rounds 9 through 12 were all the Discord adapter, both open blockers are in the
# oracle). common feeds the context hash and epoch math everything depends on. test, scripts, tools,
# and the package files are the harness itself, and a harness change must prove the suite still runs.
needs_suite=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    core/*|circuits/*|contract/*|prover/*|adapters/*|common/*|oracle/*|test/*|scripts/*|tools/*|package.json|package-lock.json)
      needs_suite=1
      ;;
  esac
done <<EOF
$staged
EOF

[ "$needs_suite" -eq 0 ] && exit 0

# Two suites at once contend for the same loopback port, and gateway_http then waits forever rather
# than failing (a documented gotcha that cost real time twice). Two layers, each stated at its real
# strength. The mkdir lock is atomic and excludes two of THESE hooks racing. The pgrep probe is
# BEST EFFORT against a manually started suite: it can miss one started between probe and launch,
# and it matches any 'node --test' on the host, which errs toward refusing (a suite from another
# repository is not proven to share the port, it is just not proven safe).
# The trap removes only a lock this process owns (pid recorded inside), so an operator clearing a
# lock they judged stale cannot have it yanked back out from under a new holder by the old hook's
# cleanup. A termination the trap cannot see (signal 9) leaves the lock behind, which errs toward
# refusing and is what the removal message below is for.
LOCK="$ROOT/.git/precommit-suite.lock"
if ! mkdir "$LOCK" 2>/dev/null; then
  holder="$(cat "$LOCK/pid" 2>/dev/null || echo unknown)"
  echo "COMMIT BLOCKED: another pre-commit suite run holds $LOCK (pid $holder)."
  echo "If that process is gone, a terminated hook left the lock behind. Remove it with:"
  echo "  rm -rf '$LOCK'"
  exit 1
fi
echo "$$" > "$LOCK/pid"
trap '[ "$(cat "$LOCK/pid" 2>/dev/null)" = "$$" ] && rm -rf "$LOCK"' EXIT
if pgrep -f 'node --test' >/dev/null 2>&1; then
  echo "COMMIT BLOCKED: a 'node --test' run is already active on this host. Two suites contend"
  echo "for the same loopback port and hang rather than fail. Let it finish, then commit."
  exit 1
fi

# A FILE LISTING, NOT git status, and this took three tries to get right, which is the point of
# testing a gate rather than trusting it. `git status --porcelain --ignored` collapses an ignored
# directory to one `!! data/` entry, and `--ignored=matching` does the same when the ignore pattern
# IS the directory, which is exactly the shape here. So a probe test that deliberately created
# data/GATE_PROBE.tmp committed cleanly, twice, while the gate reported no change at all.
#
# Listing paths catches the case this exists for, a test creating state through a real deployment
# path. It does NOT catch a test that modifies an existing file in place, and that limit is stated
# rather than implied.
tree_snapshot() {
  find . -path ./.git -prune -o -path ./node_modules -prune -o -type f -print 2>/dev/null | sort
}
tree_before="$(tree_snapshot)"

echo "pre-commit: staged changes touch gated paths, running npm test (about 2.5 minutes)"
if ! npm test; then
  echo ""
  echo "COMMIT BLOCKED: npm test failed. Fix the suite, or if committing a known-failing state is"
  echo "genuinely intended, commit with --no-verify and say why in the message."
  exit 1
fi

# THE SUITE MUST NOT CHANGE THE WORKING TREE. A test writing through a deployment's default path
# leaves real operational state behind and makes its own later phases depend on what an earlier run
# left. That happened here: a Platform test wrote data/platform_schedule.json, the production
# default, and it took a reviewer prompting a look at the tree to notice.
tree_after="$(tree_snapshot)"
if [ "$tree_before" != "$tree_after" ]; then
  echo ""
  echo "COMMIT BLOCKED: the test suite created or removed files in the working tree."
  echo "A test is writing through a real path instead of a temporary one, so it leaves state behind"
  echo "and its later runs depend on what an earlier run left. Point the test at a temp directory."
  diff <(printf '%s\n' "$tree_before") <(printf '%s\n' "$tree_after") | head -20
  exit 1
fi

# AND IT MUST NOT LEAVE PROCESSES RUNNING. Orphaned gateway children hold their loopback ports, and
# the next suite run then waits on them forever rather than failing, which cost real time twice in
# one session before this check existed.
# GRACE PERIOD, because proc.kill() returns before the child has actually gone. A test that
# terminates its gateway correctly can still have that child alive for a moment after the suite
# exits, and an instant check called that a leak: this gate blocked a commit on 2026-08-04 while two
# clean runs immediately afterwards showed ZERO leaked processes. A gate that fires falsely is worse
# than no gate, because the response to it is --no-verify and then nobody reads it again. Five
# seconds is far longer than a shutdown and far shorter than a leak, which never resolves.
# ONLY REAL node PROCESSES COUNT, and this took two corrections. `pgrep -f core/gateway.js` matches
# ANY process whose argument list contains that string, which includes the shell running the commit
# itself whenever the commit message or the invoking command mentions the path. So the gate blocked
# a commit because of the TEXT OF ITS OWN COMMIT MESSAGE, and it did so invisibly: `ps -o args=`
# truncates long argument lists, so a debug print of the matches showed nothing at all while pgrep
# kept returning true. That combination is worth remembering, since it makes the false positive look
# like a phantom.
#
# Filtering on the executable name fixes it by construction. A leaked gateway is `node`; a shell or
# a python wrapper quoting the path is not, whatever its arguments say.
#
# The five second grace exists separately: proc.kill() returns before the child is gone, so a
# correctly terminated gateway can still be alive for a moment after the suite exits.
leaked_gateways() {
  local pid
  for pid in $(pgrep -f 'core/gateway.js' 2>/dev/null); do
    case "$(ps -p "$pid" -o comm= 2>/dev/null)" in
      *node) echo "$pid" ;;
    esac
  done
}
leak_deadline=$((SECONDS + 5))
while [ $SECONDS -lt $leak_deadline ]; do
  [ -z "$(leaked_gateways)" ] && break
  sleep 1
done
stray="$(leaked_gateways)"
if [ -n "$stray" ]; then
  echo ""
  echo "COMMIT BLOCKED: the test suite left a gateway process running: $(echo "$stray" | tr '\n' ' ')"
  echo "still alive 5 seconds after the suite finished, so this is a leak rather than a slow exit."
  echo "A test started a child and did not terminate it on every path, including its failure paths."
  exit 1
fi
exit 0
